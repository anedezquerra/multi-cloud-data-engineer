\addvspace {10\p@ }
\contentsline {figure}{\numberline {1}{\ignorespaces A safe Snowflake learning setup moves from trial creation to security, compute, cost controls, and verification.}}{9}{figure.0.1}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.1}{\ignorespaces Snowflake's three-layer architecture separates coordination, compute, and storage while allowing multiple warehouses to access the same data.}}{17}{figure.1.1}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Micro-partition metadata lets Snowflake prune storage units whose date and region ranges cannot satisfy the predicate.}}{19}{figure.1.2}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces A telecom CDR architecture separates raw retention, typed facts, hot lookup tables, and aggregate serving layers.}}{25}{figure.1.3}%
\contentsline {figure}{\numberline {1.4}{\ignorespaces Capstone CDR architecture connecting Cloud Services metadata, virtual warehouse compute, pruning, and a clustering maintenance loop.}}{29}{figure.1.4}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Snowflake query execution can benefit from result cache, metadata pruning, and warehouse-local cache, but each cache has different eligibility and lifecycle rules.}}{37}{figure.2.1}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces A multi-cluster warehouse scales out by adding same-size clusters to absorb concurrent queued work over shared data.}}{40}{figure.2.2}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Per-team warehouse isolation lets BI, ETL, and data science share governed data without sharing the same compute queue.}}{43}{figure.2.3}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Capstone architecture for measuring isolated BI, ETL, and data-science compute against one shared governed data model.}}{47}{figure.2.4}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Table type selection forms a persistence and recovery spectrum from session scratch work to protected business data.}}{54}{figure.3.1}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Search Optimization Service adds a Snowflake-managed access path so selective predicates can target candidate micro-partitions instead of broad table scans.}}{56}{figure.3.2}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces E-commerce analytics acceleration should match query families: materialized views for recurring aggregates, SOS for point lookups, clustering for pruning, and warehouses for broad compute.}}{60}{figure.3.3}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Capstone architecture for testing e-commerce acceleration features against a permanent fact table fed by transient ETL staging.}}{63}{figure.3.4}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Time Travel is the user-operable recovery window; Fail-safe follows as a Snowflake-managed last-resort tier for permanent data.}}{69}{figure.4.1}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces A zero-copy clone shares existing micro-partitions at creation and writes new storage only when data changes.}}{72}{figure.4.2}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces A clone-based DevOps workflow creates isolated staging environments quickly, tests changes, and drops ephemeral objects before storage divergence grows.}}{75}{figure.4.3}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Milestone 1 reference architecture combining isolated warehouses, durable and transient storage layers, targeted acceleration, clone-based QA, and Time Travel recovery testing.}}{79}{figure.4.4}%
