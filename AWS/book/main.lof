\contentsline {figure}{\numberline {4.2}{\ignorespaces Spiky-traffic mobile sports API using API Gateway, AppSync, ElastiCache, DAX, DynamoDB, Aurora or RDS, and streaming ingestion.}}{79}{figure.4.2}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Milestone 1 e-commerce reference architecture integrating Aurora Serverless v2, DynamoDB, S3, ElastiCache, DAX, AWS DMS, and observability across all tiers.}}{83}{figure.4.3}%
